# For running Terraform locally. Copy to backend.hcl (git-ignored); values come from
# `terraform -chdir=infra/bootstrap output`. The deploy workflow passes these itself.
resource_group_name  = "rg-ticketing-shared"
storage_account_name = "<state_storage_account output>"
container_name       = "tfstate"
key                  = "ticketing-dev.tfstate"
use_azuread_auth     = true
